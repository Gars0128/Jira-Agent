# Local development only. Copy to .env; do not commit .env.
POSTGRES_DB=discovery
POSTGRES_USER=discovery
POSTGRES_PASSWORD=local_dev_password

# Phase 4: OpenAI extraction. Put real keys in ignored .env, never in chat.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-terra
# Standard text-token rates, USD per 1M tokens. Verify when changing model.
LLM_INPUT_USD_PER_MILLION=2.00
LLM_OUTPUT_USD_PER_MILLION=12.00
MAX_COST_PER_RUN_USD=0.10
LLM_MAX_OUTPUT_TOKENS=4096

# Optional LangSmith agent-based workspace. Register this agent in the UI first.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=discovery-jira
LANGSMITH_AGENT_ENVIRONMENT=local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=required-only-if-the-key-can-access-multiple-workspaces
