# Local development only. Copy to .env; do not commit .env.
POSTGRES_DB=discovery
POSTGRES_USER=discovery
POSTGRES_PASSWORD=local_dev_password

# Phase 4: OpenAI extraction. Put real keys in ignored .env, never in chat.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-terra
# Standard text-token rates, USD per 1M tokens. Verify when changing model.
LLM_INPUT_USD_PER_MILLION=2.00
LLM_OUTPUT_USD_PER_MILLION=12.00
MAX_COST_PER_RUN_USD=0.30
LLM_MAX_OUTPUT_TOKENS=4096

# Optional LangSmith agent-based workspace. Register this agent in the UI first.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=discovery-jira
LANGSMITH_AGENT_ENVIRONMENT=local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=required-only-if-the-key-can-access-multiple-workspaces

# Phase 5: Postgres + pgvector for spec chunks. Neon: direct (non-pooled) URL
# with sslmode=require. Empty uses PG* variables (docker-compose).
DATABASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_USD_PER_MILLION=0.02

# Public demo always forces dry-run, even if JIRA_DRY_RUN is false.
PUBLIC_DEMO=true
JIRA_DRY_RUN=true
DAILY_BUDGET_USD=1.00
MAX_PENDING_RUNS=8
# Private Jira mode only: PUBLIC_DEMO=false and JIRA_DRY_RUN=false.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
