# Free local runs through Ollama: load after .env, e.g.
#   uv run --env-file ../../.env --env-file ../../.env.ollama ...
# Numbers measure qwen3:14b, not the production model. No secrets here.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=qwen3:14b
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=600
# Settings require positive prices; near-zero keeps budget accounting working.
LLM_INPUT_USD_PER_MILLION=0.000001
LLM_OUTPUT_USD_PER_MILLION=0.000001
EMBEDDING_MODEL=embeddinggemma:300m
EMBEDDING_USD_PER_MILLION=0.000001
